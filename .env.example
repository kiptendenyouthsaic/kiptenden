# WhatsApp authentication
SESSION_ID=

# Kiptenden Youths identity
BOT_NAME=KIPTENDEN YOUTHS
OWNER_NAME=Kiptenden Youths
OWNER_NUMBER=254796271291
MODE=public
TIME_ZONE=Africa/Nairobi

# AI provider settings
# auto = use the OpenAI-compatible backend when AI_API_KEY exists
AI_PROVIDER=auto
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REASONING_EFFORT=
AI_REASONING_PARAM=reasoning
POLLINATIONS_MODEL=openai
POLLINATIONS_API_KEY=
# Keep false unless Pollinations access is configured and intentionally used.
ALLOW_POLLINATIONS_FALLBACK=false

# Chatbot routing: allchats, inbox, or groups
CHATBOT_MODE=allchats

# Bible verse service. The default is the public bible-api.com endpoint.
BIBLE_API_BASE_URL=https://bible-api.com
BIBLE_TRANSLATION=web

# Lyrics service. LRCLIB is keyless and searchable by song title or artist.
LYRICS_API_BASE_URL=https://lrclib.net
LYRICS_USER_AGENT=Kiptenden Youths Bot/1.0 (lyrics command)

# Local music downloader settings. Docker installs yt-dlp and ffmpeg.
YTDLP_PATH=yt-dlp
YTDLP_JS_RUNTIME=node
# Optional only if YouTube returns bot verification in your Render region.
# Use a private Render secret; never commit cookies to GitHub.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=
YTDLP_PROXY=
PLAY_MAX_MB=25

# Optional bot settings
BOT_PIC=
AUTO_READ_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_UPDATE=false
BOT_REPO=
NEWSLETTER_JID=
NEWSLETTER_URL=
YT=

# Logo generation. `auto` uses the legacy ephoto service when configured, then Pollinations fallback.
# Set LOGO_PROVIDER=pollinations to skip the legacy service entirely.
LOGO_PROVIDER=auto
POLLINATIONS_IMAGE_MODEL=flux
LOGO_FALLBACK_ENABLED=true
LOGO_API_TIMEOUT_MS=60000

# Optional legacy integrations. The logo plugin uses these when both are configured.
LEGACY_API_BASE_URL=
LEGACY_API_KEY=

# Optional persistence and service settings
DATABASE_URL=
PORT=5000
